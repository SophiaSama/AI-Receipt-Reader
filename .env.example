# Frontend (Vite) — Supabase configuration
# Copy to .env.local and fill in values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
# The publishable (anon) key is safe to expose in the browser. NEVER put the
# service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Optional: override the OCR/AI processing endpoint base (defaults to /api).
# VITE_API_BASE_URL=/api
