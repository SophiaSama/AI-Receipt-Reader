# Environment variables for E2E tests

# Application URLs
BASE_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Optional API forwarding
# By default, the app is expected to serve API routes under BASE_URL/api.
# If you run the backend separately (e.g. on port 3001), you can forward
# all browser /api/* calls to that backend origin.
FORWARD_API_TO_BACKEND=false
BACKEND_ORIGIN=http://localhost:3001

# Browser settings
HEADLESS=false
SLOW_MO=0
RECORD_VIDEO=false

# --- Supabase (auth + data + storage) ---
# LOCAL stack (Option A) defaults shown. The local stack runs in Docker and
# requires hardware virtualization (see README: "Running E2E locally against a
# local Supabase stack"). Get real values from `npx supabase status -o env`.
# CI auto-generates these from its disposable Supabase stack, so they only
# matter for LOCAL runs. If you don't run e2e locally you can leave the two
# keys empty: the publishable key is only needed for login, and the
# service-role key only powers the between-test cleanup (a no-op when empty).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-anon-key
# Service-role key is used ONLY by tests to wipe the receipts table between runs.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# --- Seeded E2E users (created by supabase/seed.sql in the local stack) ---
# User A is the default logged-in user for authenticated UI flows.
E2E_USER_A_EMAIL=test-user-a@example.com
E2E_USER_A_PASSWORD=test-password-a
# User B is only needed for the RLS data-isolation test.
E2E_USER_B_EMAIL=test-user-b@example.com
E2E_USER_B_PASSWORD=test-password-b

# Test data
TEST_RECEIPT_IMAGE=fixtures/sample-receipt.png

# Timeouts (milliseconds)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000

# Debugging
DEBUG=false
TRACE=false
